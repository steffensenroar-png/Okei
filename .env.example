# Supabase (Project Settings > API). Offentlige verdier, trygge i nettleseren.
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hemmelige, bare på serveren (Vercel > Settings > Environment Variables)
ANTHROPIC_API_KEY=
KASSALAPP_API_KEY=

# Valgfritt: overstyr AI-modellen
# ANTHROPIC_MODEL=claude-sonnet-5-5
